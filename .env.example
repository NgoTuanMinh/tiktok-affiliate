# Copy file này thành `.env` và điền giá trị thật.

# --- API keys ---
GEMINI_API_KEY=
PEXELS_API_KEY=

# Model Gemini (google-genai SDK). Ví dụ: gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Cache kết quả 1-request theo story+offer (giảm gọi API khi chạy lại)
GEMINI_CACHE=true
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE_SECONDS=2

# --- TTS provider ---
# Để TRỐNG = chỉ dùng Edge TTS (miễn phí). Chỉ đặt elevenlabs khi đã có credit.
TTS_PROVIDER=

# --- ElevenLabs (tuỳ chọn, giọng hay hơn) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional tinh chỉnh chất giọng (có thể giữ mặc định)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true

